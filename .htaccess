# MRitmo · mritmo.com (Hostinger, LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.html index.php

AddType application/json .json
AddType font/woff2 .woff2
AddDefaultCharset utf-8

RewriteEngine On

# assetlinks.json must answer directly on both hosts, without redirects,
# or Android won't verify the App Links (mritmo.com/u/<usuario>).
RewriteRule ^\.well-known/ - [L]

# A single host: www.mritmo.com → mritmo.com. (HTTPS is forced from hPanel → SSL,
# not here: behind Hostinger's CDN an HTTPS check in .htaccess can loop.)
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://mritmo.com/$1 [R=301,L]

# iPhone and iPad (1.9): there's no APK for them; the home page explains it.
RewriteCond %{HTTP_USER_AGENT} (iPhone|iPad|iPod) [NC]
RewriteRule ^descargar/?$ /#descargar [R=302,NE,L]

# Always the newest APK (every release also publishes it as MRitmo.apk).
RewriteRule ^descargar/?$ https://github.com/s3bsbarr/MRitmo/releases/latest/download/MRitmo.apk [R=302,L]

# Invitation link: mritmo.com/u/<usuario> → the bridge page (the address stays the same).
# PHP fills "@usuario te invita a MRitmo" in the title and share tags (1.9).
RewriteRule ^u/[A-Za-z0-9_.]+/?$ /u/index.php [L]

<IfModule mod_headers.c>
  # Security headers. Everything (font included) is served from mritmo.com itself:
  # no third-party scripts, styles, fonts or trackers are allowed to load.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "version.json">
    Header set Cache-Control "no-cache"
  </Files>
  <Files "assetlinks.json">
    Header set Content-Type "application/json"
    Header set Access-Control-Allow-Origin "*"
  </Files>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS/JS: references carry ?v=<commit> (stamped on deploy); short cache as a fallback.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
